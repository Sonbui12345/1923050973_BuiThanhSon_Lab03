export function average(list: Subject[]): number {
  if (!list || list.length === 0) return 0;
  const totalWeightedScore = list.reduce((sum, s) => sum + (s.score * s.credits), 0);
  const totalCredits = list.reduce((sum, s) => sum + s.credits, 0);
  if (totalCredits === 0) return 0;
  const avg = totalWeightedScore / totalCredits;
  return Math.round((avg + Number.EPSILON) * 100) / 100;
}

export function passCount(list: Subject[], threshold: number = PASS_THRESHOLD): number {
  if (!list) return 0;
  return list.filter((s) => s.score >= threshold).length;
}

export function topThree(list: Subject[]): Subject[] {
  if (!list) return [];
  return [...list]
    .sort((a, b) => b.score - a.score)
    .slice(0, 3);
}

export function byStatus(list: Subject[]): Record<SubjectStatus, number> {
  const initialCounts: Record<SubjectStatus, number> = {
    passed: 0,
    failed: 0,
    in_progress: 0,
    retake: 0,
  };
  if (!list) return initialCounts;
  return list.reduce((acc, s) => {
    acc[s.status] = (acc[s.status] ?? 0) + 1;
    return acc;
  }, { ...initialCounts });
}
