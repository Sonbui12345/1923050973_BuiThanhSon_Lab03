  // Accessible helper tokens for status indicators without using inline hex colors
  headerBg: string;
  headerText: string;
  badgePassed: string;
  badgePassedText: string;
  badgeFailed: string;
  badgeFailedText: string;
  badgeOther: string;
  badgeOtherText: string;
  footerBg: string;
}

